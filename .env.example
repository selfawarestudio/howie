# Twilio (required for outbound SMS and inbound webhook verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+1XXXXXXXXXX
TWILIO_TO=+1XXXXXXXXXX

# Model credential — pick one path:
# On Vercel after `vercel link`, OIDC is automatic; no key needed locally in prod.
# For local dev with the AI Gateway:
# AI_GATEWAY_API_KEY=...
# Or use a direct provider key matching your model prefix in agent/agent.ts.
