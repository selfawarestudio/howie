# Slack (Vercel Connect — see README)
SLACK_CONNECT_UID=slack/howie
SLACK_CHANNEL_ID=C0123456789

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_TO=+1XXXXXXXXXX
# Required for US SMS (A2P 10DLC). Create in Console after campaign approval.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional when using a Messaging Service; otherwise required.
TWILIO_FROM=+1XXXXXXXXXX

# Model credential — pick one path:
# On Vercel after `vercel link`, OIDC is automatic; no key needed locally in prod.
# For local dev with the AI Gateway:
# AI_GATEWAY_API_KEY=...
# Or use a direct provider key matching your model prefix in agent/agent.ts.
